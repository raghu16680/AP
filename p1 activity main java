import android.os.Bundle;
import android.widget.Button;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    Button viewTextUi;
    Button clearTextUi;
    TextView textContainerUi;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        setContentView(R.layout.activity_main);

        // Connect XML views with Java
        viewTextUi = findViewById(R.id.viewTextUi);
        clearTextUi = findViewById(R.id.clearTextUi);
        textContainerUi = findViewById(R.id.textContainerUi);

        // View button
        viewTextUi.setOnClickListener(v -> {
            textContainerUi.setText("Hello World!");
        });

        // Clear button
        clearTextUi.setOnClickListener(v -> {
            textContainerUi.setText("");
        });
    }
}
